{
  "$schema": "https://json-schema.org",
  "title": "MaterialLifecycleAsset",
  "type": "object",
  "required": ["asset_id", "material_formula_hash", "co2_sequestration_per_kg", "total_mass_kg", "circular_economy_metadata"],
  "properties": {
    "asset_id": { "type": "string", "format": "uuid" },
    "material_formula_hash": { "type": "string" },
    "co2_sequestration_per_kg": { "type": "number" },
    "total_mass_kg": { "type": "number", "minimum": 0 },
    "circular_economy_metadata": {
      "type": "object",
      "required": ["rfid_tag_id", "estimated_lifespan_months", "target_reclamation_center_id"],
      "properties": {
        "rfid_tag_id": { "type": "string" },
        "estimated_lifespan_months": { "type": "integer", "minimum": 1 },
        "target_reclamation_center_id": { "type": "string", "format": "uuid" }
      }
    }
  }
}
